# Jump to f where B is set to 42 -> Size of B is 10 (as we consider the return location g). This size bound is important for the loop at l2.
(GOAL COMPLEXITY)
(STARTTERM (FUNCTIONSYMBOLS l0))
(RETURNLOCATIONS (FUNCTIONSYMBOLS g))
(VAR A B)
(RULES
  l0(A,B) -> l1(A,B)
  l1(A,B) -> l1(A - 1,f[B|(A,B) <- (A,42)]) :|: A > 0
  f(A,B) -> g(A,10)
  l1(A,B) -> l2(A,B) :|: A <= 0
  l2(A,B) -> l2(A,B - 1) :|: B > 0
)
